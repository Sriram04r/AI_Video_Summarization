# ==========================================
# AI-Powered Video Summarization System Config
# ==========================================

# 1. Google Gemini AI API key (from Google AI Studio)
# Required for summarization, study notes, quizzes, Q&A chat, and cloud transcription
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Database connection string
# Default: Local SQLite database file in the workspace
# Production example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL="sqlite:///database/db.sqlite"

# 3. JWT token signature secret
# Generate a random hex key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="dfc863a34a8109dbe98218a562479e0be6f1947b1e428bc57d2cf0a1c6204780"

# 4. Groq API Key (required if AI_PROVIDER="groq")
# Obtain from: https://console.groq.com/
GROQ_API_KEY="gsk_YourGroqApiKeyHere"

# 5. AI Service Provider: "gemini" or "groq"
AI_PROVIDER="gemini"

